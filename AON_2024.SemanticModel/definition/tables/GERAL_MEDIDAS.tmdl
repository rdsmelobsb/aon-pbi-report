/// Tabela central com os KPIs consolidados de investimento, alcance e eficiência de mídia.
table GERAL_MEDIDAS
	lineageTag: 82023333-b9be-4b47-a195-7e3b4ecc33ce

	/// Volume consolidado de impressões entregues nas campanhas de redes sociais.
	measure G_impressões = [rd_impressões]
		formatString: #,0
		displayFolder: Consolidado Geral
		lineageTag: f9de497c-50ff-4aa0-9881-494a934db837

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Total de reproduções de vídeo completas (100% de exibição).
	measure G_visualizacao100 = [rd_video100]
		formatString: #,0
		displayFolder: Consolidado Geral
		lineageTag: b495b88c-4748-45cf-9b98-b3a216b937a2

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Total de reproduções de vídeo que atingiram o primeiro quartil (25%).
	measure G_video25 = [rd_video25]
		formatString: #,0
		displayFolder: Consolidado Geral
		lineageTag: e5a4bc71-8300-43be-9a7c-d9ebdf374261

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Taxa de retenção de vídeo (vídeos que completaram 100% sobre os que atingiram 25%).
	measure G_retencao = DIVIDE('GERAL_MEDIDAS'[G_visualizacao100],'GERAL_MEDIDAS'[G_video25])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Consolidado Geral
		lineageTag: d29d8801-99cf-459e-9674-f08a602f49e2

		changedProperty = FormatString

	/// Total consolidado de cliques no link gerados pelas campanhas de mídia.
	measure G_cliques = [rd_cliques]
		formatString: #,0
		displayFolder: Consolidado Geral
		lineageTag: da8cdbe0-430d-416a-9dfc-187723f12bf3

	/// Taxa de cliques consolidada (Cliques no Link / Impressões).
	measure G_CTR = DIVIDE([G_cliques],'GERAL_MEDIDAS'[G_impressões])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Consolidado Geral
		lineageTag: 091ba48f-606e-4f72-9e20-3c9593e2f2e9

		changedProperty = FormatString

	/// Investimento financeiro total consolidado desembolsado nas campanhas.
	measure G_Custo = [rd_custo]
		formatString: "R$"#,0.0;-"R$"#,0.0;"R$"#,0.0
		displayFolder: Consolidado Geral
		lineageTag: 090684e5-8fb2-478c-a17f-e702a9f29e02

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Eficiência de aquisição (Custo Total de Mídia / Sessões GA4 geradas).
	measure 'G_Custo por sessão' = DIVIDE([G_Custo],[GA_Sessões])
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		displayFolder: Consolidado Geral
		lineageTag: 2b697502-d6b4-4f04-b7dd-54fb0a0a6af8

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	/// Total de inícios de reprodução de vídeo nas redes sociais.
	measure G_views = [rd_views]
		formatString: #,0
		displayFolder: Consolidado Geral
		lineageTag: aaef70ae-1140-4708-940c-a25655ac2f48

		changedProperty = FormatString

	/// Mensagem com data e horário da última sincronização dos dados.
	measure Atualizacao =
			
			"Atualizado em " &
			FORMAT(MAX(dm_atualizacao[DataAtualizacao]), "dd/mm/yyyy") & ", às " &
			FORMAT(MAX(dm_atualizacao[DataAtualizacao]), "HH\hmm")
		displayFolder: Informações & Rodapé
		lineageTag: 948ba5e7-178f-4714-adb6-42f3917abff0

	/// Texto de rodapé com as plataformas de mídia de origem.
	measure '_Rodape Fontes' = "Fonte dos dados: Meta Ads, Google Ads, Tiktok Ads, Linkedin Ads e plano de mídia."
		displayFolder: Informações & Rodapé
		lineageTag: 58a0766b-87f5-40ee-a990-00a579e0d361

	/// Texto de rodapé com as fontes de dados para a visão receptiva.
	measure '_Rodape receptivo' = "Fonte dos dados: GA4, Meta Ads, Linkedin Ads, TikTok Ads e Google Ads."
		displayFolder: Informações & Rodapé
		lineageTag: 0e64a817-febe-4158-a0af-7160079b32a4

	partition GERAL_MEDIDAS-fac087a5-5c4a-4c61-8db3-d22672ecfde2 = m
		mode: import
		queryGroup: MEDIDAS
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

