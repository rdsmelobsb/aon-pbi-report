	partition DATA_DIM-235369e7-35b3-428e-9a50-e3acb6cc8991 = m
		mode: import
		queryGroup: DIMENSÕES
		source =
				let
				    // Definir a data inicial e o número de dias
				    DataInicial = List.Min(REDES_FATO[Date]), // Substitua pela entrada do usuário
				    NumDias = Duration.Days( Date.From(DateTime.FixedLocalNow()) - DataInicial ), // Substitua pelo número de dias desejado
				
				    // Criar uma lista de datas
				    ListaDatas = List.Transform({0..(NumDias-1)}, each Date.AddDays(DataInicial, _)),
				
				    // Converter a lista em uma tabela
				    Tabela = Table.FromList(ListaDatas, Splitter.SplitByNothing(), {"Data"}),
				
				    // Adicionar a coluna do mês
				    TabelaComMes = Table.AddColumn(Tabela, "Mês", each Date.ToText([Data], "MMMM", "pt-BR")),
				    #"Tipo Alterado" = Table.TransformColumnTypes(TabelaComMes,{{"Data", type date}}),
				    #"Ano Inserido" = Table.AddColumn(#"Tipo Alterado", "Ano", each Date.Year([Data]), Int64.Type),
				    #"Coluna Mesclada Inserida" = Table.AddColumn(#"Ano Inserido", "Período", each Text.Combine({[Mês], Text.From([Ano], "pt-BR")}, " - "), type text),
				    #"Linhas Agrupadas" = Table.Group(#"Coluna Mesclada Inserida", {"Período"}, {{"Dados", each _, type table [Data=nullable date, Mês=text, Ano=number, Período=text]}}),
				    #"Índice Adicionado" = Table.AddIndexColumn(#"Linhas Agrupadas", "ID-PERÍODO", 1, 1, Int64.Type),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Índice Adicionado",{"Período"}),
				    #"Dados Expandido" = Table.ExpandTableColumn(#"Colunas Removidas", "Dados", {"Data", "Mês", "Ano", "Período"}, {"Data", "Mês", "Ano", "Período"}),
				    #"Linhas Classificadas" = Table.Sort(#"Dados Expandido",{{"Data", Order.Descending}}),
				    #"Personalização Adicionada" = Table.AddColumn(#"Linhas Classificadas", "Check", each true),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Personalização Adicionada",{{"Check", type logical}}),
				    #"Mês Inserido" = Table.AddColumn(#"Tipo Alterado1", "Mês.1", each Date.Month([Data]), Int64.Type),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Mês Inserido",{{"Ano", type text}}),
				    #"Semana do Mês Inserida" = Table.AddColumn(#"Tipo Alterado2", "Semana do Mês", each Date.WeekOfMonth([Data]), Int64.Type),
				    #"Coluna Mesclada Inserida1" = Table.AddColumn(#"Semana do Mês Inserida", "Semana Mes Ano", each Text.Combine({Text.From([Semana do Mês], "pt-BR"), Text.From([Mês.1], "pt-BR"), [Ano]}, " - "), type text),
				    #"Início da Semana Inserido" = Table.AddColumn(#"Coluna Mesclada Inserida1", "Início da Semana", each Date.StartOfWeek([Data]), type date),
				    #"Fim da Semana Inserido" = Table.AddColumn(#"Início da Semana Inserido", "Fim da Semana", each Date.EndOfWeek([Data]), type date),
				    #"Coluna Mesclada Inserida2" = Table.AddColumn(#"Fim da Semana Inserido", "Mesclado", each Text.Combine({Text.From([Início da Semana], "pt-BR"), " - ", Text.From([Fim da Semana], "pt-BR")}), type text),
				    #"Valor Substituído" = Table.ReplaceValue(#"Coluna Mesclada Inserida2","/2025","",Replacer.ReplaceText,{"Mesclado"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","/2024","",Replacer.ReplaceText,{"Mesclado"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído1","/2026","",Replacer.ReplaceText,{"Mesclado"}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Valor Substituído2",{{"Mesclado", "Semana"}})
				in
				    #"Colunas Renomeadas"

