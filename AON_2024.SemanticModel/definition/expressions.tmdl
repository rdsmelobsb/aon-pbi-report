expression CONSOLIDADO =
		let
		    // Obtém os dados da API
		    Fonte = Json.Document(Web.Contents("https://sheets.googleapis.com/v4/spreadsheets/1FvzidQKeIvV1f7HWI5OsN_dJLCOkzv1LW-32VHTyCak/values/CONSOLIDADO?key=AIzaSyBZ5XVts4aPnRgENl4rj5C8Lb2gg6Bu_LU")),
		
		    // Extrai os valores (lista de listas)
		    ListaDeLinhas = Fonte[values],
		
		    // Descobre o número máximo de colunas na tabela
		    NumeroColunas = List.Max(List.Transform(ListaDeLinhas, each List.Count(_))),
		
		    // Completa as linhas com valores vazios ("") para garantir o mesmo número de colunas
		    LinhasAjustadas = List.Transform(ListaDeLinhas, each List.FirstN(List.Combine({_, List.Repeat({""}, NumeroColunas)}), NumeroColunas)),
		
		    // Converte a lista ajustada em uma tabela
		    TabelaBruta = Table.FromRows(LinhasAjustadas),
		
		    // Usa a primeira linha como cabeçalho
		    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(TabelaBruta, [PromoteAllScalars=true]),
		    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"Plataforma", type text}, {"Placement", type text}, {"Date", type date}, {"Account", type text}, {"Campaign name", type text}, {"Campaign start date", type date}, {"Campaign end date", type date}, {"Ad set name", type text}, {"Promoted post name", type text}, {"Campaign objective", type text}, {"Promoted post image URL", type text}, {"Url Destino", type text}, {"Cost", Currency.Type}, {"Impressions", Int64.Type}, {"Link clicks", Int64.Type}, {"Post reactions", Percentage.Type}, {"Post comments", Int64.Type}, {"Post shares", Int64.Type}, {"Video play actions", Int64.Type}, {"Video watches at 25%", Int64.Type}, {"Video watches at 50%", Int64.Type}, {"Video watches at 75%", Int64.Type}, {"Video watches at 100%", Int64.Type}, {"SEED", type text}}),
		    #"Linhas Filtradas" = Table.SelectRows(#"Tipo Alterado", each ([Cost] <> 0))
		in
		    #"Linhas Filtradas"
	lineageTag: 7f443476-e8a7-4414-beb7-30150db330d5

