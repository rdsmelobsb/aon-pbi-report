expression Validação =
		//(texto as text) =>
		
		(texto as nullable text) as logical =>
		let
		    Fonte = if texto = null or texto = "" then false else Text.PositionOfAny(texto, {"0".."9"}) >= 0
		in
		    Fonte
	lineageTag: c22237c6-f0dd-4084-bb76-fae407618b1c

